class Solution {
    public int[] getConcatenation(int[] nums) {
        int[] res=new int[nums.length+nums.length];
        int k=0;
        for(int i=0;i<nums.length;i++){
            res[k++]=nums[i];
        }
        for(int j=0;j<nums.length;j++){
            res[k++]=nums[j];
        }
        return res;   
    }
}

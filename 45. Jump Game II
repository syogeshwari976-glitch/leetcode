class Solution {
    public int jump(int[] nums) {
        int n=nums.length;
        if(nums[0]==0){
            return 0;
        }
        if(n<=1){
            return 0;
        }
        int cur=0,m=0,jump=0;
        for(int i=0;i<n;i++){
            m=Math.max(m,i+nums[i]);
            if(m>=n-1){
                return jump+1;
            }
            if(i==cur){
                if(i==m){
                    return 0;
                }
                else{
                    jump++;
                    cur=m;
                }
            }
        }
        return 0;
        
    }
}

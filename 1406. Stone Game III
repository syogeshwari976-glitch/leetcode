class Solution {
    public String stoneGameIII(int[] stoneValue) {
        int n = stoneValue.length;
        int[] dp = new int[n + 1];
        
        // Bottom-up DP from the end of the array to the beginning
        for (int i = n - 1; i >= 0; i--) {
            int maxAdvantage = Integer.MIN_VALUE;
            int currentSum = 0;
            
            // Try taking 1, 2, or 3 stones
            for (int k = 1; k <= 3 && i + k <= n; k++) {
                currentSum += stoneValue[i + k - 1];
                maxAdvantage = Math.max(maxAdvantage, currentSum - dp[i + k]);
            }
            dp[i] = maxAdvantage;
        }
        
        // Analyze the result from Alice's starting position (index 0)
        if (dp[0] > 0) {
            return "Alice";
        } else if (dp[0] < 0) {
            return "Bob";
        } else {
            return "Tie";
        }
        
    }
}
